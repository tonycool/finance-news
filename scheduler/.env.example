# ── Sender credentials ──────────────────────────────────────────────────────
# Option A: Gmail with App Password
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Generate a password for "Mail" / "Other"
#   4. Paste it below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Option B: SendGrid (free tier — 100 emails/day)
#   1. Sign up at sendgrid.com
#   2. Settings → API Keys → Create API Key (Mail Send permission)
#   3. Uncomment and fill in below, comment out Option A above
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option C: Outlook / Hotmail
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@outlook.com
# SMTP_PASS=your-password

# ── Email addresses ───────────────────────────────────────────────────────────
FROM_NAME=The Finance Daily
FROM_EMAIL=you@gmail.com
TO_EMAIL=recipient@example.com

# ── Behaviour ────────────────────────────────────────────────────────────────
# How many top articles to include in the email (default: 30)
MAX_ARTICLES=30
